layout: null
lang: zh-CN
permalink: /zh/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign posts = site.posts | where: 'lang', page.lang %}<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>{{ site.title | xml_escape }}</title><link>{{ page.url | replace: 'feed.xml', '' | absolute_url }}</link><description>{{ site.data.translations[page.lang].tagline | xml_escape }}</description><language>{{ page.lang }}</language><atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml"/>{% for post in posts limit: 20 %}<item><title>{{ post.title | xml_escape }}</title><link>{{ post.url | absolute_url }}</link><guid isPermaLink="true">{{ post.url | absolute_url }}</guid><pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.description | xml_escape }}</description></item>{% endfor %}</channel></rss>
