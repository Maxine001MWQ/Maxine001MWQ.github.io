---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.title | xml_escape }}</title><link>{{ '/' | absolute_url }}</link><description>{{ site.description | xml_escape }}</description>{% for post in site.posts limit: 20 %}<item><title>{{ post.title | xml_escape }}</title><link>{{ post.url | absolute_url }}</link><guid>{{ post.url | absolute_url }}</guid><description>{{ post.description | xml_escape }}</description></item>{% endfor %}</channel></rss>
